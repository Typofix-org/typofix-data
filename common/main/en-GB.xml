  <rules>
    <rule>
      <id>421</id>
      <order>1</order>
      <name>Add nonbreraking space before ellipsis at the end of a sentence</name>
      <description>Add nonbreraking space before ellipsis at the end of a sentence</description>
      <category>
        <name>Spaces</name>
        <name>Add space before/after ellipsis (prefs)</name>
      </category>
      <source>
        <search><![CDATA[\p{Zs}?\x{2026}(?=$|\r?\n)]]></search>
        <replace><![CDATA[\x{00A0}\x{2026}]]></replace>
      </source>
      <resolved>
        <grep>
          <search><![CDATA[\p{Zs}?\x{2026}(?=$|\r?\n)]]></search>
          <replace><![CDATA[\x{00A0}\x{2026}]]></replace>
        </grep>
        <ecma>
          <search><![CDATA[\p{Zs}?\u{2026}(?=$|\r?\n)]]></search>
          <replace><![CDATA[\u{00A0}\u{2026}]]></replace>
          <flags>gv</flags>
        </ecma>
      </resolved>
      <unresolved/>
      <caseInsensitive>false</caseInsensitive>
      <alertOnly>false</alertOnly>
      <automatic>false</automatic>
      <manual>false</manual>
      <examples>
        <example>
          <before>Han tøvede et øjeblik, før han svarede… (Danish)</before>
          <after>Han tøvede et øjeblik, før han svarede … (Danish)</after>
        </example>
      </examples>
    </rule>
  </rules>
