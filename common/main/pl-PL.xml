  <rules>
    <rule>
      <id>192</id>
      <order>1</order>
      <name>The correct form of born in year (1974–)</name>
      <description>The correct form of born in year (1974–) with endash between parenthesis&#13;
</description>
      <category>
        <name>Punctuation</name>
        <name>Hyphens and dashes</name>
      </category>
      <source>
        <search><![CDATA[(?:@{ParentLeft})\p{Nd}{4}\K(?:\p{Zs}\p{Pd}|(?:@{pPd2013}))(?=@{ParentRight})]]></search>
        <replace><![CDATA[@{DashRange}]]></replace>
      </source>
      <resolved>
        <grep>
          <search><![CDATA[(?:\x{0028}|\x{005B}|\x{007B})\p{Nd}{4}\K(?:\p{Zs}\p{Pd}|(?:[\x{002D}\x{2010}\x{2011}\x{2012}\x{2014}\x{2015}]))(?=\x{0029}|\x{005D}|\x{007D})]]></search>
          <replace><![CDATA[\x{2013}]]></replace>
        </grep>
        <ecma>
          <search><![CDATA[(?<=(?:\u{0028}|\u{005B}|\u{007B})\p{Nd}{4})(?:\p{Zs}\p{Pd}|(?:[\p{Pd}--\u{2013}]))(?=\u{0029}|\u{005D}|\u{007D})]]></search>
          <replace><![CDATA[\u{2013}]]></replace>
          <flags>gv</flags>
        </ecma>
      </resolved>
      <unresolved/>
      <caseInsensitive>false</caseInsensitive>
      <alertOnly>false</alertOnly>
      <automatic>false</automatic>
      <manual>true</manual>
      <examples>
        <example>
          <before>Project (1974-)
Project (1974 –)</before>
          <after>Project (1974–)
Project (1974–)</after>
        </example>
      </examples>
    </rule>
  </rules>
