  <rules>
    <rule>
      <id>293</id>
      <order>1</order>
      <name>Replace space by nonbreaking space between ordinal number and following word or abbreviation</name>
      <description>Replace space by nonbreaking space between ordinal number and following abbreviation (1. LF)</description>
      <category>
        <name>Numbers</name>
        <name>Ordinals</name>
      </category>
      <source>
        <search><![CDATA[(?<![[:graph:]])@{LB}(\d+)(@{OrdSuffix})\K\p{Zs}(?=@{AbbAfterOrd})]]></search>
        <replace><![CDATA[\x{00A0}]]></replace>
      </source>
      <resolved>
        <grep>
          <search><![CDATA[(?<![[:graph:]])\b(\d+)(\.)\K\p{Zs}(?=LF)]]></search>
          <replace><![CDATA[\x{00A0}]]></replace>
        </grep>
        <ecma>
          <search><![CDATA[(?<=(?<![^\p{Z}\p{C}])(?<![\p{L}\p{M}\p{N}])(\p{Nd}+)(\.))\p{Zs}(?=LF)]]></search>
          <replace><![CDATA[\u{00A0}]]></replace>
          <flags>gv</flags>
        </ecma>
      </resolved>
      <unresolved/>
      <caseInsensitive>false</caseInsensitive>
      <alertOnly>false</alertOnly>
      <automatic>false</automatic>
      <manual>true</manual>
      <examples>
        <example>
          <before>Pracuje pro 1. LF.</before>
          <after>Pracuje pro 1. LF.</after>
        </example>
      </examples>
    </rule>
    <rule>
      <id>339</id>
      <order>2</order>
      <name>Replace space by nonbreaking space between ordinal number marked with period and following word</name>
      <description>Replace space by nonbreaking space between ordinal number marked with period and following word (1. místo)</description>
      <category>
        <name>Numbers</name>
        <name>Ordinals</name>
      </category>
      <source>
        <search><![CDATA[(?<![[:graph:]])(?<!(\p{Nd}\.\p{zs}))(?:(?:[\(\[\{\/@{QL1}@{QL2}])|(?:(?:[\(\[\{\/@{QL1}@{QL2}])?\p{Nd}+\.@{Dash}))?(?:\p{Nd}+)\.\K@{pZs00A0}(?!@{Months})(?=(?:[[:lower:]]{2,}|[[:lower:]]\p{Zs}[[:lower:]]{2,}))]]></search>
        <replace><![CDATA[\x{00A0}]]></replace>
      </source>
      <resolved>
        <grep>
          <search><![CDATA[(?<![[:graph:]])(?<!(\p{Nd}\.\p{zs}))(?:(?:[\(\[\{\/„‚])|(?:(?:[\(\[\{\/„‚])?\p{Nd}+\.\x{2013}))?(?:\p{Nd}+)\.\K[\x{0020}\x{1680}\x{2000}-\x{200A}\x{202F}\x{205F}\x{3000}](?!lede?na?|února?|února|březe?na?|dube?na?|květe?na?|máje?|červe?na?|červene?ce?|srpe?na?|září|říje?na?|listopadu?|prosine?ce?)(?=(?:[[:lower:]]{2,}|[[:lower:]]\p{Zs}[[:lower:]]{2,}))]]></search>
          <replace><![CDATA[\x{00A0}]]></replace>
        </grep>
        <ecma>
          <search><![CDATA[(?<=(?<![^\p{Z}\p{C}])(?<!(\p{Nd}\.\p{Zs}))(?:(?:[\(\[\{\/@\{QL1\}@\{QL2\}])|(?:(?:[\(\[\{\/@\{QL1\}@\{QL2\}])?\p{Nd}+\.\u{2013}))?(?:\p{Nd}+)\.)[\p{Zs}--\u{00A0}](?!lede?na?|února?|února|březe?na?|dube?na?|květe?na?|máje?|červe?na?|červene?ce?|srpe?na?|září|říje?na?|listopadu?|prosine?ce?)(?=(?:\p{Ll}{2,}|\p{Ll}\p{Zs}\p{Ll}{2,}))]]></search>
          <replace><![CDATA[\u{00A0}]]></replace>
          <flags>gv</flags>
        </ecma>
      </resolved>
      <unresolved/>
      <caseInsensitive>false</caseInsensitive>
      <alertOnly>false</alertOnly>
      <automatic>false</automatic>
      <manual>true</manual>
      <examples>
        <example>
          <before>3. vydání (2. u nás) (Czech)</before>
          <after>3. vydání (2. u nás) (Czech)</after>
        </example>
      </examples>
    </rule>
    <rule>
      <id>60</id>
      <order>3</order>
      <name>Hyphen to en-dash preceded by a nonbreaking space</name>
      <description>Hyphen to parenthetical en-dash preceded by a nonbreaking space to keep dashes at the end of the line (includes possible comma after dash)</description>
      <category>
        <name>Punctuation</name>
        <name>Hyphens and dashes</name>
      </category>
      <source>
        <search><![CDATA[(?:(?:\p{Zs}@{pPd2013}\p{Zs}?)|(?:@{pZs00A0}\p{Pd}\p{Zs}?))(\x{002C})?\p{Zs}(?!\p{Pd})]]></search>
        <replace><![CDATA[\x{00A0}@{Dash}$1\x{0020}]]></replace>
      </source>
      <resolved>
        <grep>
          <search><![CDATA[(?:(?:\p{Zs}[\x{002D}\x{2010}\x{2011}\x{2012}\x{2014}\x{2015}]\p{Zs}?)|(?:[\x{0020}\x{1680}\x{2000}-\x{200A}\x{202F}\x{205F}\x{3000}]\p{Pd}\p{Zs}?))(\x{002C})?\p{Zs}(?!\p{Pd})]]></search>
          <replace><![CDATA[\x{00A0}@{Dash}$1\x{0020}]]></replace>
        </grep>
        <ecma>
          <search><![CDATA[(?:(?:\p{Zs}[\p{Pd}--\u{2013}]\p{Zs}?)|(?:[\p{Zs}--\u{00A0}]\p{Pd}\p{Zs}?))(\u{002C})?\p{Zs}(?!\p{Pd})]]></search>
          <replace><![CDATA[\u{00A0}@{Dash}$1\u{0020}]]></replace>
          <flags>gv</flags>
        </ecma>
      </resolved>
      <unresolved>
        <code>Dash</code>
      </unresolved>
      <caseInsensitive>false</caseInsensitive>
      <alertOnly>false</alertOnly>
      <automatic>false</automatic>
      <manual>true</manual>
      <examples>
        <example>
          <before>word - word</before>
          <after>word – word</after>
        </example>
        <example>
          <before>Přišel pozdě - ale nikomu to nevadilo.</before>
          <after>Přišel pozdě – ale nikomu to nevadilo.</after>
        </example>
      </examples>
    </rule>
  </rules>
