                "privateuse": "",
                "title": "English (UK)",
                "localName": "English (UK)"
            },
            "rules": [
                {
                    "id": 421,
                    "order": 1,
                    "name": "Add nonbreraking space before ellipsis at the end of a sentence",
                    "description": "Add nonbreraking space before ellipsis at the end of a sentence",
                    "category": [
                        "Spaces",
                        "Add space before/after ellipsis (prefs)"
                    ],
                    "source": {
                        "search": "\\p{Zs}?\\x{2026}(?=$|\\r?\\n)",
                        "replace": "\\x{00A0}\\x{2026}"
                    },
                    "resolved": {
                        "grep": {
                            "search": "\\p{Zs}?\\x{2026}(?=$|\\r?\\n)",
                            "replace": "\\x{00A0}\\x{2026}"
                        },
                        "ecma": {
                            "search": "\\p{Zs}?\\u{2026}(?=$|\\r?\\n)",
                            "replace": "\\u{00A0}\\u{2026}",
                            "flags": "gv"
                        }
                    },
                    "unresolved": [],
                    "caseInsensitive": false,
                    "alertOnly": false,
                    "automatic": false,
                    "manual": false,
                    "examples": [
                        {
                            "before": "Han tøvede et øjeblik, før han svarede… (Danish)",
                            "after": "Han tøvede et øjeblik, før han svarede … (Danish)"
                        }
                    ]
                }
            ],
            "variables": [
                {
                    "code": "OrdSuffix",
                    "extend": {
