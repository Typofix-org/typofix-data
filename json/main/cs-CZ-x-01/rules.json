            "rules": [
                {
                    "id": 293,
                    "order": 1,
                    "name": "Replace space by nonbreaking space between ordinal number and following word or abbreviation",
                    "description": "Replace space by nonbreaking space between ordinal number and following abbreviation (1. LF)",
                    "category": [
                        "Numbers",
                        "Ordinals"
                    ],
                    "source": {
                        "search": "(?<![[:graph:]])@{LB}(\\d+)(@{OrdSuffix})\\K\\p{Zs}(?=@{AbbAfterOrd})",
                        "replace": "\\x{00A0}"
                    },
                    "resolved": {
                        "grep": {
                            "search": "(?<![[:graph:]])\\b(\\d+)(\\.)\\K\\p{Zs}(?=LF)",
                            "replace": "\\x{00A0}"
                        },
                        "ecma": {
                            "search": "(?<=(?<![^\\p{Z}\\p{C}])(?<![\\p{L}\\p{M}\\p{N}])(\\p{Nd}+)(\\.))\\p{Zs}(?=LF)",
                            "replace": "\\u{00A0}",
                            "flags": "gv"
                        }
                    },
                    "unresolved": [],
                    "caseInsensitive": false,
                    "alertOnly": false,
                    "automatic": false,
                    "manual": true,
                    "examples": [
                        {
                            "before": "Pracuje pro 1. LF.",
                            "after": "Pracuje pro 1. LF."
                        }
                    ]
                },
                {
                    "id": 339,
                    "order": 2,
                    "name": "Replace space by nonbreaking space between ordinal number marked with period and following word",
                    "description": "Replace space by nonbreaking space between ordinal number marked with period and following word (1. místo)",
                    "category": [
                        "Numbers",
                        "Ordinals"
                    ],
                    "source": {
                        "search": "(?<![[:graph:]])(?<!(\\p{Nd}\\.\\p{zs}))(?:(?:[\\(\\[\\{\\/@{QL1}@{QL2}])|(?:(?:[\\(\\[\\{\\/@{QL1}@{QL2}])?\\p{Nd}+\\.@{Dash}))?(?:\\p{Nd}+)\\.\\K@{pZs00A0}(?!@{Months})(?=(?:[[:lower:]]{2,}|[[:lower:]]\\p{Zs}[[:lower:]]{2,}))",
                        "replace": "\\x{00A0}"
                    },
                    "resolved": {
                        "grep": {
                            "search": "(?<![[:graph:]])(?<!(\\p{Nd}\\.\\p{zs}))(?:(?:[\\(\\[\\{\\/„‚])|(?:(?:[\\(\\[\\{\\/„‚])?\\p{Nd}+\\.\\x{2013}))?(?:\\p{Nd}+)\\.\\K[\\x{0020}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}](?!lede?na?|února?|února|březe?na?|dube?na?|květe?na?|máje?|červe?na?|červene?ce?|srpe?na?|září|říje?na?|listopadu?|prosine?ce?)(?=(?:[[:lower:]]{2,}|[[:lower:]]\\p{Zs}[[:lower:]]{2,}))",
                            "replace": "\\x{00A0}"
                        },
                        "ecma": {
                            "search": "(?<=(?<![^\\p{Z}\\p{C}])(?<!(\\p{Nd}\\.\\p{Zs}))(?:(?:[\\(\\[\\{\\/@\\{QL1\\}@\\{QL2\\}])|(?:(?:[\\(\\[\\{\\/@\\{QL1\\}@\\{QL2\\}])?\\p{Nd}+\\.\\u{2013}))?(?:\\p{Nd}+)\\.)[\\p{Zs}--\\u{00A0}](?!lede?na?|února?|února|březe?na?|dube?na?|květe?na?|máje?|červe?na?|červene?ce?|srpe?na?|září|říje?na?|listopadu?|prosine?ce?)(?=(?:\\p{Ll}{2,}|\\p{Ll}\\p{Zs}\\p{Ll}{2,}))",
                            "replace": "\\u{00A0}",
                            "flags": "gv"
                        }
                    },
                    "unresolved": [],
                    "caseInsensitive": false,
                    "alertOnly": false,
                    "automatic": false,
                    "manual": true,
                    "examples": [
                        {
                            "before": "3. vydání (2. u nás) (Czech)",
                            "after": "3. vydání (2. u nás) (Czech)"
                        }
                    ]
                },
                {
                    "id": 60,
                    "order": 3,
                    "name": "Hyphen to en-dash preceded by a nonbreaking space",
                    "description": "Hyphen to parenthetical en-dash preceded by a nonbreaking space to keep dashes at the end of the line (includes possible comma after dash)",
                    "category": [
                        "Punctuation",
                        "Hyphens and dashes"
                    ],
                    "source": {
                        "search": "(?:(?:\\p{Zs}@{pPd2013}\\p{Zs}?)|(?:@{pZs00A0}\\p{Pd}\\p{Zs}?))(\\x{002C})?\\p{Zs}(?!\\p{Pd})",
                        "replace": "\\x{00A0}@{Dash}$1\\x{0020}"
                    },
                    "resolved": {
                        "grep": {
                            "search": "(?:(?:\\p{Zs}[\\x{002D}\\x{2010}\\x{2011}\\x{2012}\\x{2014}\\x{2015}]\\p{Zs}?)|(?:[\\x{0020}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}]\\p{Pd}\\p{Zs}?))(\\x{002C})?\\p{Zs}(?!\\p{Pd})",
                            "replace": "\\x{00A0}@{Dash}$1\\x{0020}"
                        },
                        "ecma": {
                            "search": "(?:(?:\\p{Zs}[\\p{Pd}--\\u{2013}]\\p{Zs}?)|(?:[\\p{Zs}--\\u{00A0}]\\p{Pd}\\p{Zs}?))(\\u{002C})?\\p{Zs}(?!\\p{Pd})",
                            "replace": "\\u{00A0}@{Dash}$1\\u{0020}",
                            "flags": "gv"
                        }
                    },
                    "unresolved": [
                        "Dash"
                    ],
                    "caseInsensitive": false,
                    "alertOnly": false,
                    "automatic": false,
                    "manual": true,
                    "examples": [
                        {
                            "before": "word - word",
                            "after": "word – word"
                        },
                        {
                            "before": "Přišel pozdě - ale nikomu to nevadilo.",
                            "after": "Přišel pozdě – ale nikomu to nevadilo."
                        }
                    ]
                }
            ],
