                            "(?:(?:maj|październik|(?:stycz|(?:kwiec|sierp|wrzes|grudz)i)eń|(?:maj|październik|listopad|(?:kwiet|wrześ|grud|s(?:tycz|ierp))ni|(?:mar|czerw|lip)c)a|(?:marz|(?:czerw|lip)i)ec|l(?:istopad|ut(?:ego|y))))"
