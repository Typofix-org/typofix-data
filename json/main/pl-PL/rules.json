{
    "$schema": "https://typofix.org/schema/v1/rules.json",
    "version": "1",
    "report": "https://typofix.org/report",
    "main": {
        "pl-PL": {
            "identity": {
                "type": "pl-PL",
                "icu": "pl_PL",
                "language": "pl",
                "script": "",
                "region": "PL",
                "privateuse": "",
                "title": "Polish",
                "localName": "polski"
            },
            "rules": [
                {
                    "id": 192,
                    "order": 1,
                    "name": "The correct form of born in year (1974–)",
                    "description": "The correct form of born in year (1974–) with endash between parenthesis\r\n",
                    "category": [
                        "Punctuation",
                        "Hyphens and dashes"
                    ],
                    "source": {
                        "search": "(?:@{ParentLeft})\\p{Nd}{4}\\K(?:\\p{Zs}\\p{Pd}|(?:@{pPd2013}))(?=@{ParentRight})",
                        "replace": "@{DashRange}"
                    },
                    "resolved": {
                        "grep": {
                            "search": "(?:\\x{0028}|\\x{005B}|\\x{007B})\\p{Nd}{4}\\K(?:\\p{Zs}\\p{Pd}|(?:[\\x{002D}\\x{2010}\\x{2011}\\x{2012}\\x{2014}\\x{2015}]))(?=\\x{0029}|\\x{005D}|\\x{007D})",
                            "replace": "\\x{2013}"
                        },
                        "ecma": {
                            "search": "(?<=(?:\\u{0028}|\\u{005B}|\\u{007B})\\p{Nd}{4})(?:\\p{Zs}\\p{Pd}|(?:[\\p{Pd}--\\u{2013}]))(?=\\u{0029}|\\u{005D}|\\u{007D})",
                            "replace": "\\u{2013}",
                            "flags": "gv"
                        }
                    },
                    "unresolved": [],
                    "caseInsensitive": false,
                    "alertOnly": false,
                    "automatic": false,
                    "manual": true,
                    "examples": [
                        {
                            "before": "Project (1974-)\nProject (1974 –)",
                            "after": "Project (1974–)\nProject (1974–)"
                        }
                    ]
                }
            ],
            "variables": [
                {
                    "code": "OrdSuffix",
                    "extend": {
                        "grep": [
                            "\\.",
                            "\\x{00BA}"
                        ],
                        "ecma": [
                            "\\.",
                            "\\u{00BA}"
                        ]
                    }
                },
                {
                    "code": "QL1",
                    "extend": {
                        "grep": [
                            "„"
                        ],
                        "ecma": [
                            "„"
                        ]
                    },
                    "preference": {
                        "defaultValue": {
                            "grep": "„",
                            "ecma": "„"
                        },
                        "values": {
                            "grep": [
                                {
                                    "name": "„ [low-double-99]",
                                    "value": "„",
                                    "preview": "„",
