{
    "$schema": "https://typofix.org/schema/v1/variables.json",
    "version": "1",
    "report": "https://typofix.org/report",
    "supplemental": {
        "variables": [
            {
                "code": "OrdSuffix",
                "name": "Ordinal Suffixes",
                "description": "Ordinal indicator is a character, group of characters or a symbol following a numeral denoting that it is an ordinal number (1st, 2:a 3., 4ª)",
                "values": {
                    "grep": [],
                    "ecma": []
                }
            },
            {
                "code": "QL1",
                "name": "Quote Left Primary",
                "description": "Primary (default) left quotation mark",
                "values": {
                    "grep": [],
                    "ecma": []
                }
            },
            {
                "code": "QL2",
                "name": "Quote Left Secondary",
                "description": "Secondary (nested) left quotation mark",
                "values": {
                    "grep": [],
                    "ecma": []
                }
            },
            {
                "code": "Months",
                "name": "Months",
                "description": "List of names of months incl. abbreviated forms and inflected forms (January, jaanuar, jaanuari, jaanuaril…)",
                "values": {
                    "grep": [],
                    "ecma": []
                }
            },
            {
                "code": "DashRange",
                "name": "Dash indicating range of values",
                "description": "Select the proper lenght of a standard dash (en-dash or em-dash) in closed range of values (1–10, 1910–1947, 12 000–24 000, 12.000–24.000)",
                "values": {
                    "grep": [
                        "\\x{2013}"
                    ],
                    "ecma": [
                        "\\u{2013}"
                    ]
                }
            },
            {
                "code": "Dash",
                "name": "Dash",
                "description": "The alternative options for a standard en-dash used in a sentence (not as a range or relation indicator)",
                "values": {
                    "grep": [
                        "\\x{2013}"
                    ],
                    "ecma": [
                        "\\u{2013}"
                    ]
                }
            },
            {
                "code": "AbbAfterOrd",
                "name": "Abbreviations after ordinal numbers",
                "description": "List of expressions which should be connected to a preceding ordinal number with nonbreaking space to prevent splitting at the end of a line (1. LF)",
                "values": {
                    "grep": [],
                    "ecma": []
                }
            },
            {
                "code": "pZs00A0",
                "name": "Spaces (without nonbreaking space U+00A0)",
                "description": "Spaces (without nonbreaking space U+00A0)",
                "values": {
                    "grep": [
                        "[\\x{0020}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}]"
                    ],
                    "ecma": [
                        "[\\p{Zs}--\\u{00A0}]"
                    ]
                }
            },
            {
                "code": "pPd2013",
                "name": "Dashes (without en-dash U+2013)",
                "description": "Dashes (without en-dash U+2013)",
                "values": {
                    "grep": [
                        "[\\x{002D}\\x{2010}\\x{2011}\\x{2012}\\x{2014}\\x{2015}]"
                    ],
                    "ecma": [
                        "[\\p{Pd}--\\u{2013}]"
                    ]
                }
            },
            {
                "code": "ParentLeft",
                "name": "Opening parentheses and brackets",
                "description": "Opening parentheses and brackets: ( [ {",
                "values": {
                    "grep": [
                        "\\x{0028}",
                        "\\x{005B}",
                        "\\x{007B}"
                    ],
                    "ecma": [
                        "\\u{0028}",
                        "\\u{005B}",
                        "\\u{007B}"
                    ]
                }
            },
            {
                "code": "ParentRight",
                "name": "Closing parentheses and brackets",
                "description": "Closing parentheses and brackets: ) ] }",
                "values": {
                    "grep": [
                        "\\x{0029}",
                        "\\x{005D}",
                        "\\x{007D}"
                    ],
                    "ecma": [
                        "\\u{0029}",
                        "\\u{005D}",
                        "\\u{007D}"
                    ]
                }
            },
            {
                "code": "LB",
                "name": "Left Word Boundary",
                "description": "Left word boundary",
                "values": {
                    "grep": [
                        "\\b"
                    ],
                    "ecma": [
                        "(?<![\\p{L}\\p{M}\\p{N}])"
                    ]
                }
            }
        ]
    }
}
